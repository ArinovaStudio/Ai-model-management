generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = "-1"
  enable_experimental_decimal = true
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Project {
  id                  String               @id @default(uuid())
  name                String
  summary             String?
  priority            String?
  basicDetails        String?
  repository          String?
  status              Int                  @default(0)
  createdAt           DateTime             @default(now())
  progress            Int                  @default(0)
  currentPhase        String?              @default("Design")
  projectInfo         ProjectInfo?
  projectIntelligence ProjectIntelligence?
  featureRequests     FeatureRequest[]
  technologies        ProjectTechnology[]
  riskBlockages       RiskBlockage[]
  planDocs            PlanDoc[]
  docs                Doc[]
  groupingTasks       GroupingTask[]
  resourceAllocations ResourceAllocation[]
  chatMessages        ChatMessage[]
  wbsStatus           String               @default("DRAFT")
}

model ProjectIntelligence {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  productStrategy      Json?
  featureSpecs         Json?
  systemArchitecture   Json?
  aiIntelligence       Json?
  databaseDesign       Json?
  apiDesign            Json?
  backendEngineering   Json?
  frontendArchitecture Json?
  security             Json?
  scalability          Json?
  economics            Json?
  roadmapAndQa         Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectInfo {
  id              String    @id @default(uuid())
  projectId       String    @unique
  budget          Float
  paidAmount      Float?    @default(0)
  clientName      String?
  projectType     String
  startDate       DateTime
  deadline        DateTime?
  supervisorAdmin String?
  name            String    @default("Unnamed Project")
  description     String?
  scope           String?
  constraints     String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FeatureRequest {
  id                  String   @id @default(uuid())
  clientId            String
  projectId           String
  title               String
  description         String
  createdAt           DateTime @default(now())
  status              String   @default("pending")
  priority            String   @default("medium")
  category            String?
  sourceDocId         String?
  sourceDocType       String?
  embedding           String?
  isAmbiguous         Boolean  @default(false)
  clarificationPrompt String?
  metadata            String?
  updatedAt           DateTime @default(now()) @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsTasks            Task[]
}

model ProjectTechnology {
  id           String   @id @default(uuid())
  projectId    String
  tech         Json[]
  name         String   @default("Unknown Tech")
  category     String   @default("backend")
  version      String?
  isDetected   Boolean  @default(true)
  dependencies String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RiskBlockage {
  id               String   @id @default(uuid())
  projectId        String
  clientId         String
  riskTitle        String
  type             String   @default("risk")
  category         String   @default("general")
  title            String   @default("Unknown")
  description      String   @default("")
  severity         String   @default("medium")
  status           String   @default("open")
  sourceFeatureId  String?
  sourceDocId      String?
  reportType       String   @default("risk")
  metadata         String?
  confidenceScore  Float?   @default(0)
  planningWarnings String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ResourceAllocation {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role               String
  requiredCount      Int      @default(1)
  allocatedHours     Float    @default(0)
  workloadPercentage Float?   @default(0)
  recommendedCount   Float?   @default(0)
  metadata           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model PlanDoc {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  embedding String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Doc {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  docType   String?
  embedding String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Analytics {
  id            String   @id
  quoteText     String?
  quoteAuthor   String?
  totalProjects Int      @default(0)
  pendingTasks  Int      @default(0)
  design        Int      @default(0)
  development   Int      @default(0)
  marketing     Int      @default(0)
  sales         Int      @default(0)
  support       Int      @default(0)
  analytics     Int      @default(0)
  updatedAt     DateTime
  createdAt     DateTime @default(now())
}

model Asset {
  id         String   @id
  type       String
  url        String
  title      String
  uploadedBy String?
  userImage  String?
  createdAt  DateTime @default(now())
  projectId  String
  publicId   String?
  liveUrl    String?
}

model BankDetails {
  id                String @id
  userId            String @unique
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  branchName        String
  upiId             String
}

model BreakModel {
  id        String     @id
  userId    String
  type      BREAK_TYPE
  startTime DateTime
  endTime   DateTime?
  duration  Int?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime

  @@index([userId, startTime])
  @@map("Break")
}

model CalendarEvent {
  id        String    @id
  title     String
  date      DateTime
  type      EventType
  userId    String?
  isGlobal  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime

  @@index([isGlobal, date])
  @@index([userId, date])
}

model Certificate {
  id          String   @id
  title       String
  description String?
  imageUrl    String
  publicId    String
  assignedTo  String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ClockRecord {
  id        String       @id
  userId    String
  clockIn   DateTime?
  clockOut  DateTime?
  date      DateTime     @default(now())
  status    CLOCK_STATUS @default(NOT_LOGGED_IN)
  createdAt DateTime     @default(now())
  updatedAt DateTime

  @@index([userId, date])
}

model Comment {
  id        String   @id
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
}

model DesignSystem {
  id               String   @id
  projectId        String   @unique
  brandName        String
  colors           String[]
  fonts            Json
  designType       String[]
  layoutStyle      Json
  contentTone      String[]
  visualGuidelines Json
  theme            String[]
  brandFeel        String
  keyPages         String[]
  uniqueness       Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model Docs {
  id        String   @id
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
  userId    String?
  projectId String?
}

model DocumentAccess {
  id     String  @id
  docId  String
  userId String
  role   String?

  @@unique([docId, userId])
}

model GroupingTask {
  id                 String    @id @default(uuid())
  name               String?
  description        String?
  order              Int       @default(0)
  featureIds         String?
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks              Task[]
  task               Json?
  users              Json?
  totalEffortHours   Float?    @default(0)
  totalDurationDays  Float?    @default(0)
  avgComplexityScore Float?    @default(0)
  sprintNumber       Int?
  sprintStart        DateTime?
  sprintEnd          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
}

model LatestUpdate {
  id        String   @id
  title     String
  date      String
  projectId String
  createdBy String
  createdAt DateTime @default(now())
}

model Meeting {
  id          String   @id
  title       String
  description String   @db.VarChar(150)
  scheduledAt DateTime
  meetingLink String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model MeetingAttendee {
  id        String @id
  meetingId String
  userId    String

  @@unique([meetingId, userId])
}

model MeetingRequest {
  id          String   @id
  reason      String
  meetDate    DateTime
  meetTime    String
  status      String   @default("pending")
  meetingLink String?
  createdBy   String?
  duration    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  clientId    String
  projectId   String?
}

model Memo {
  id        String   @id
  meetingId String
  message   String
  clientId  String
  totaltime String
  createdAt DateTime @default(now())
}

model Milestone {
  id          String           @id @default(uuid())
  projectId   String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime
  status      MILESTONE_STATUS @default(PENDING)
  createdBy   String
  createdAt   DateTime         @default(now())
}

model MultiTaskGroup {
  id        String   @id
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MultiTaskUser {
  id         String   @id
  groupId    String
  taskId     String
  userId     String
  name       String?
  role       String?
  department String?
  label      String?
  createdAt  DateTime @default(now())

  @@unique([groupId, userId])
}

model Navigation {
  id      String  @id
  title   String?
  package String  @unique
  menu    Json
}

model Notification {
  id        String   @id
  userId    String
  title     String
  message   String
  image     String?
  type      String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notificationlist {
  id           String  @id
  title        String?
  package      String? @unique
  notification Json
}

model OtpVerification {
  id        String   @id
  email     String
  otp       String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model PaymentMethod {
  id                String       @id
  userId            String
  type              PAYMENT_TYPE
  upiId             String?
  accountNumber     String?
  ifscCode          String?
  bankName          String?
  accountHolderName String?
  isPreferred       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime

  @@index([userId])
}

model PaymentQuery {
  id          String       @id
  payoutId    String
  userId      String
  status      QUERY_STATUS @default(OPEN)
  subject     String
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([payoutId])
  @@index([userId, status])
}

model PaymentRequest {
  id            String                 @id
  requestedToId String
  requestedById String
  title         String
  description   String?
  amount        Decimal                @db.Decimal(10, 2)
  currency      String                 @default("INR")
  paymentMethod PaymentMode?           @default(MANUAL)
  gateway       PaymentGateway?        @default(RAZORPAY)
  status        PAYMENT_REQUEST_STATUS @default(PENDING)
  invoice       String?
  extensionDate DateTime?
  dueDate       DateTime
  paidAt        DateTime?
  transactionId String?
  paymentProof  String?
  paymentDate   DateTime?
  hasClientPaid Boolean                @default(false)
  isPaidMarked  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime
  projectId     String?

  @@index([requestedById])
  @@index([requestedToId])
}

model PaymentTicket {
  id               String        @id
  paymentRequestId String        @unique
  description      String
  raisedById       String
  status           TICKET_STATUS @default(OPEN)
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  closedAt         DateTime?

  @@index([paymentRequestId])
}

model Payout {
  id              String        @id
  userId          String
  transactionId   String        @unique
  amount          Float
  paymentDate     DateTime
  paymentMethod   PAYMENT_TYPE
  sentFrom        String
  paymentProofUrl String?
  status          PAYOUT_STATUS @default(PENDING)
  isReceived      Boolean       @default(false)
  receivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime

  @@index([userId, paymentDate])
}

model PayoutSchedule {
  id             String    @id
  userId         String    @unique
  nextAmount     Float?
  nextPayoutDate DateTime
  lastPayoutDate DateTime?
  payoutDay      Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([nextPayoutDate])
}

model PerformanceRating {
  id            String   @id
  userId        String
  newLearnings  Int      @default(5)
  speed         Int      @default(5)
  workQuality   Int      @default(5)
  leaves        Int      @default(5)
  communication Int      @default(5)
  feedback      Int      @default(5)
  ratedBy       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model PlanDocs {
  id        String   @id
  name      String   @default("United")
  content   String
  createdBy String
  createdAt DateTime @default(now())
  projectId String?
}

model ProjectMember {
  id        String  @id
  projectId String
  userId    String
  role      String?
  isLeader  Boolean @default(false)
}

model QueryMessage {
  id         String   @id
  queryId    String
  senderId   String
  senderRole ROLES
  message    String
  createdAt  DateTime @default(now())

  @@index([queryId])
}

model Report {
  id         String   @id
  message    String
  taskId     String?
  reportedBy String?
  createdAt  DateTime @default(now())
}

model Roadmap {
  id          String    @id
  title       String
  description String?
  isPrivate   Boolean   @default(false)
  createdById String
  projectId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  lastEditBy  String?
  lastEditAt  DateTime?
  tldrawData  Json?

  @@index([createdById])
  @@index([projectId])
}

model RoadmapAssignment {
  id         String   @id
  roadmapId  String
  userId     String
  assignedBy String
  assignedAt DateTime @default(now())

  @@unique([roadmapId, userId])
  @@index([userId])
}

model RoadmapComment {
  id        String   @id
  roadmapId String
  userId    String
  comment   String
  nodeId    String?
  isMarked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([roadmapId])
  @@index([userId])
}

model RoadmapPermission {
  id         String             @id
  roadmapId  String
  userId     String
  permission ROADMAP_PERMISSION @default(VIEW)
  grantedBy  String
  grantedAt  DateTime           @default(now())

  @@unique([roadmapId, userId])
  @@index([userId])
}

model Role {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
}

model SharedQuote {
  id         String   @id
  quote      String
  author     String
  userId     String
  isApproved Boolean  @default(false)
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model SubRole {
  id        String   @id
  name      String
  roleId    String?
  createdAt DateTime @default(now())
}

model Task {
  id               String          @id @default(uuid())
  title            String
  description      String
  assignee         String
  assigneeAvatar   String?
  priority         String
  dueDate          DateTime
  employeeId       String?
  tags             String[]
  attachments      Json[]          @default([])
  status           String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  projectId        String?
  userId           String?
  featureRequestId String?
  featureRequest   FeatureRequest? @relation(fields: [featureRequestId], references: [id], onDelete: SetNull)
  groupId          String?
  group            GroupingTask?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  order            Int             @default(0)
  dependencies     String?
  estimatedHours   Float?
  complexityScore  Float?          @default(0)
  effortHours      Float?          @default(0)
  durationDays     Float?          @default(0)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
}

model Ticket {
  id               String   @id
  projectId        String
  reportedBy       String
  reason           String
  blockedTeammates String[] @default([])
  createdAt        DateTime @default(now())
}

model TicketMessage {
  id        String   @id
  ticketId  String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([ticketId])
}

model TodoTask {
  id          String   @id
  title       String
  description String?
  completed   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([userId, completed])
}

model UsefulTip {
  id        String   @id
  projectId String
  userId    String
  user      String
  tip       String
  createdAt DateTime @default(now())
}

model User {
  id             String    @id
  employeeId     String?   @unique
  email          String    @unique
  isDev          Boolean?  @default(false)
  githubProfile  String?
  name           String
  password       String
  workingAs      String?
  department     String?
  phone          String?
  bio            String?
  image          String?
  dob            String?
  joiningDate    DateTime?
  isLogin        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  faceDescriptor String?
  subRoleId      String?
}

model UserLeaves {
  id        String   @id
  userId    String   @unique
  remaining Int      @default(8)
  emergency Int      @default(3)
  sick      Int      @default(5)
  total     Int      @default(8)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model UserPreferredTimezone {
  id     String @id
  userId String @unique
  code   String
}

model UserTimezone {
  id        String   @id
  userId    String   @unique
  code      String
  name      String
  hours     String
  offset    String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model WaterIntake {
  id        String   @id
  userId    String
  amount    Int      @default(0)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([userId, date])
}

model WorkHours {
  id        String   @id
  userId    String
  date      DateTime
  hours     Float
  clockIn   String
  clockOut  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  summary   String?

  @@index([userId, date])
}

model clientfeedback {
  id      String  @id
  type    String
  project String?
  message String
  byName  String
  userId  String
  email   String?
}

model feedback {
  id          String  @id
  type        String
  rating      Int     @default(0)
  desc        String
  isAnynonyms Boolean @default(false)
  byName      String
  byEmpId     String
  employeeId  String?
}

model leaveReq {
  id         String   @id
  status     STATUS   @default(Pending)
  empName    String
  empId      String
  department String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  userId     String
}

model well {
  id       String @id
  title    String
  answer   String
  category String @default("Tips")
  likes    Int    @default(0)
  dislikes Int    @default(0)
}

model workDone {
  id          String   @id
  projectId   String
  taskId      String   @unique
  title       String
  description String
  priority    String
  dueDate     DateTime
  tags        String[]
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

enum BREAK_TYPE {
  COFFEE
  MEAL
  EMERGENCY
}

enum CLOCK_STATUS {
  NOT_LOGGED_IN
  CLOCKED_IN
  CLOCKED_OUT
  ON_BREAK
}

enum EventType {
  HOLIDAY
  WORKDAY
}

enum MILESTONE_STATUS {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

enum OtpType {
  SIGNUP
  FORGOT_PASSWORD
  LOGIN
}

enum PAYMENT_REQUEST_STATUS {
  PENDING
  PAID
  CANCELLED
  NOT_RECEIVED
}

enum PAYMENT_TYPE {
  UPI
  BANK_ACCOUNT
}

enum PAYOUT_STATUS {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
  PAYU
}

enum PaymentMode {
  GATEWAY
  MANUAL
}

enum QUERY_STATUS {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ROADMAP_PERMISSION {
  VIEW
  EDIT
  FULL
}

enum ROLES {
  ADMIN
  CLIENT
  EMPLOYEE
  MANAGER
  HRMANAGER
  FINANCE
  PROJECTMANAGER
}

enum STATUS {
  Requested
  Pending
  Rejected
  Approved
}

enum TICKET_STATUS {
  OPEN
  RESOLVED
  CLOSED
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String
  role      String   // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectBackup {
  id        String   @id @default(uuid())
  projectId String
  section   String   // 'intelligence', 'wbs', 'schedule', 'resources', 'documentation'
  key       String   // field name, doc ID, or identifier
  content   String   // serialized JSON or raw text
  createdAt DateTime @default(now())

  @@unique([projectId, section, key])
}
