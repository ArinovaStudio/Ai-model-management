# ==============================================================================
# Local-First Real Estate AI Agent Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realestate_ai

# Async connection string for FastAPI / SQLAlchemy asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/realestate_ai

# Sync connection string for Alembic migrations and utility scripts
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5435/realestate_ai

# ------------------------------------------------------------------------------
# CalDAV Calendar Configuration (Radicale)
# ------------------------------------------------------------------------------
CALDAV_URL=http://localhost:5232
CALDAV_USERNAME=agent
CALDAV_PASSWORD=agentpass
CALDAV_CALENDAR_NAME=SiteVisits

# ------------------------------------------------------------------------------
# Redis Cache & Session State
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ------------------------------------------------------------------------------
# LLM Intelligence (Remote Cloud GPU in Dev, Local Ollama in Prod)
# ------------------------------------------------------------------------------
# During development: Set to your Cloud GPU instance IP/domain (e.g., http://cloud-gpu-ip:11434)
# In production: Set to http://localhost:11434
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3:8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) - Faster-Whisper
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CONFIDENCE_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) - Piper ONNX
# ------------------------------------------------------------------------------
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx
PIPER_DEVICE=cpu
PIPER_CACHE_DIR=./storage/audio_cache

# ------------------------------------------------------------------------------
# Telephony & Real-Time Audio Streaming Parameters
# ------------------------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
JITTER_BUFFER_MS=20
MAX_SILENCE_DURATION_MS=600

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
DOCUMENTS_DIR=./storage/documents
