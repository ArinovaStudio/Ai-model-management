# ==============================================================================
# RealEstateAI - Production Environment Configuration Profile
# Sovereign dedicated server deployment with local internal GPU & PBX telephony
# ==============================================================================

# Application Lifecycle & Observability
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector Database Configuration (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ProdPostgresSecurePass2026!
POSTGRES_DB=realestate_ai

DATABASE_URL=postgresql+asyncpg://postgres:ProdPostgresSecurePass2026!@postgres:5432/realestate_ai
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:ProdPostgresSecurePass2026!@postgres:5432/realestate_ai

# ------------------------------------------------------------------------------
# CalDAV Calendar Service (Radicale Container)
# ------------------------------------------------------------------------------
CALDAV_URL=http://radicale:5232
CALDAV_USERNAME=agent
CALDAV_PASSWORD=ProdCalDAVSecurePass2026!
CALDAV_CALENDAR_NAME=SiteVisits

# ------------------------------------------------------------------------------
# Redis Cache & Ephemeral Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# LLM Intelligence (100% Local Sovereign Ollama on Internal NVIDIA GPU)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434
LLM_MODEL_NAME=llama3:latest
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) - Faster-Whisper int8 on Internal Hardware
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CONFIDENCE_THRESHOLD=0.70
WHISPER_DOWNLOAD_ROOT=/app/models/whisper

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) - Piper ONNX Ultra-Low Latency Speech Synthesis
# ------------------------------------------------------------------------------
PIPER_VOICE_MODEL=en_US-lessac-medium
PIPER_MODEL_PATH=/app/models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/app/models/piper/en_US-lessac-medium.onnx.json
PIPER_DEVICE=cpu
PIPER_CACHE_DIR=/app/storage/audio_cache

# ------------------------------------------------------------------------------
# Telephony & Real-Time Audio Streaming Parameters
# ------------------------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
JITTER_BUFFER_MS=20
MAX_SILENCE_DURATION_MS=600

# ------------------------------------------------------------------------------
# Sovereign Persistent Storage Paths
# ------------------------------------------------------------------------------
STORAGE_DIR=/app/storage
DOCUMENTS_DIR=/app/storage/documents
MODELS_DIR=/app/models
BACKUP_DIR=/app/storage/backups
